// ============================================================:
//  stdlib.Zlib  —  Libreria standard per il linguaggio Zim:
//  Sezioni: STRING | MATH | UTILITY:
//:
//  Uso:   ./Zinterpreter -df tuo_file.Zim -stdlib.Zlib:
//
//  Convenzioni nomi:
//    - funzioni comuni  → nome corto  (__len, __abs, __max …)
//    - funzioni rare    → nome lungo  (__array_fill, __matrix_zero …)
//
//  Note:
//    - __toupper / __tolower sono stub: ZinterPL non ha aritmetica
//      su char, quindi la conversione ASCII non e' implementabile
//      senza inline C. Le funzioni esistono ma non trasformano.
//    - __gcd usa Euclide iterativo con variabile temporanea locale.
//    - Tutti i parametri usano prefissi unici per evitare collisioni
//      con variabili del chiamante.
// ============================================================


// ============================================================
//  SEZIONE 1 — STRING
//
//  __string_at(arr, i)         → char all'indice i
//  __len(arr, n)               → numero di char non '\0' nei primi n
//  __copy(src, dst, n)         → copia n char da src a dst
//  __cmp(a, b, n)              → 1 se uguali sui primi n, 0 altrimenti
//  __string_fill(arr, ch, n)   → riempie n celle con ch
//  __string_count(arr, ch, n)  → occorrenze di ch nei primi n
//  __reverse(arr, n)           → inverte i primi n char in-place
//  __toupper(arr, n)           → STUB: non disponibile senza inline C
//  __tolower(arr, n)           → STUB: non disponibile senza inline C
// ============================================================

// --- __string_at : legge il char all'indice sa_i ---
od_ string_at(&a&sa_arr& ! &i&sa_i&){
    char_ &c&sa_ch&:
    sa_ch = [sa_i]sa_arr:
    deven_ sa_ch:
}

// --- __len : conta caratteri non '\0' nei primi n celle ---
od_ len(&a&str& ! &i&n&){
    int_  &i&len_i&:
    int_  &i&len_result&:
    char_ &c&len_ch&:
    len_i = 0:
    len_result = 0:
    during(len_i < n ! len_i++){
        len_ch = __string_at(str ! len_i):
        if(len_ch ^= '\0'){
            len_result++:
        }
        oth{
        }
    }
    deven_ len_result:
}

// --- __copy : copia i primi copy_n char da copy_src a copy_dst ---
od_ copy(&a&copy_src& ! &a&copy_dst& ! &i&copy_n&){
    int_  &i&copy_i&:
    char_ &c&copy_ch&:
    copy_i = 0:
    during(copy_i < copy_n ! copy_i++){
        copy_ch = __string_at(copy_src ! copy_i):
        [copy_i]copy_dst = copy_ch:
    }
    deven_:
}

// --- __cmp : 1 se i primi cmp_n char di cmp_a e cmp_b sono uguali ---
od_ cmp(&a&cmp_a& ! &a&cmp_b& ! &i&cmp_n&){
    int_  &i&cmp_i&:
    int_  &i&cmp_res&:
    char_ &c&cmp_ca&:
    char_ &c&cmp_cb&:
    cmp_i = 0:
    cmp_res = 1:
    during(cmp_i < cmp_n ! cmp_i++){
        cmp_ca = __string_at(cmp_a ! cmp_i):
        cmp_cb = __string_at(cmp_b ! cmp_i):
        if(cmp_ca ^= cmp_cb){
            cmp_res = 0:
        }
        oth{
        }
    }
    deven_ cmp_res:
}

// --- __string_fill : riempie sf_n celle con il carattere sf_ch ---
od_ string_fill(&a&sf_arr& ! &c&sf_ch& ! &i&sf_n&){
    int_ &i&sf_i&:
    sf_i = 0:
    during(sf_i < sf_n ! sf_i++){
        [sf_i]sf_arr = sf_ch:
    }
    deven_:
}

// --- __string_count : conta le occorrenze di sc_ch nei primi sc_n ---
od_ string_count(&a&sc_arr& ! &c&sc_ch& ! &i&sc_n&){
    int_  &i&sc_i&:
    int_  &i&sc_cnt&:
    char_ &c&sc_cur&:
    sc_i   = 0:
    sc_cnt = 0:
    during(sc_i < sc_n ! sc_i++){
        sc_cur = __string_at(sc_arr ! sc_i):
        if(sc_cur == sc_ch){
            sc_cnt++:
        }
        oth{
        }
    }
    deven_ sc_cnt:
}

// --- __reverse : inverte i primi rev_n char di rev_arr in-place ---
// Usa condition-style con due contatori perche' count-style
// valuterebbe N una sola volta all'ingresso.
od_ reverse(&a&rev_arr& ! &i&rev_n&){
    int_  &i&rev_l&:
    int_  &i&rev_r&:
    char_ &c&rev_cl&:
    char_ &c&rev_cr&:
    rev_l = 0:
    rev_r = rev_n:
    rev_r--:
    during(rev_l < rev_r ! rev_l++){
        rev_cl = __string_at(rev_arr ! rev_l):
        rev_cr = __string_at(rev_arr ! rev_r):
        [rev_l]rev_arr = rev_cr:
        [rev_r]rev_arr = rev_cl:
        rev_r--:
    }
    deven_:
}

// --- __toupper : STUB ---
// ZinterPL non supporta aritmetica su char (es. ch - 32).
// Senza inline C questa funzione non puo' convertire il caso.
// Lasciata come no-op per compatibilita' futura.
od_ toupper(&a&up_arr& ! &i&up_n&){
    deven_:
}

// --- __tolower : STUB ---
od_ tolower(&a&lo_arr& ! &i&lo_n&){
    deven_:
}


// ============================================================
//  SEZIONE 2 — MATH
//
//  __abs(x)                → valore assoluto
//  __max(a, b)             → maggiore tra due int
//  __min(a, b)             → minore tra due int
//  __clamp(x, lo, hi)      → x limitato a [lo, hi]
//  __pow(base, exp)        → base^exp  (exp >= 0)
//  __sqrt_int(x)           → floor(sqrt(x))
//  __factorial(n)          → n!  (n >= 0)
//  __divmod_rem(a, b)      → a % b
//  __divmod_quot(a, b)     → a / b  (quoziente intero)
//  __gcd(a, b)             → massimo comun divisore
//  __lcm(a, b)             → minimo comune multiplo
//  __is_even(n)            → 1 se n e' pari
//  __is_odd(n)             → 1 se n e' dispari
//  __sign(n)               → 1 / 0 / -1
// ============================================================

// --- __abs ---
// Copia n in variabile locale per non distruggere il parametro.
od_ abs(&i&abs_x&){
    int_ &i&abs_r&:
    int_ &i&abs_v&:
    abs_v = abs_x:
    abs_r = abs_v:
    if(abs_v < 0){
        abs_r = 0:
        abs_r--abs_v:
    }
    oth{
    }
    deven_ abs_r:
}

// --- __max ---
od_ max(&i&max_a& ! &i&max_b&){
    int_ &i&max_r&:
    max_r = max_a:
    if(max_b > max_a){
        max_r = max_b:
    }
    oth{
    }
    deven_ max_r:
}

// --- __min ---
od_ min(&i&min_a& ! &i&min_b&){
    int_ &i&min_r&:
    min_r = min_a:
    if(min_b < min_a){
        min_r = min_b:
    }
    oth{
    }
    deven_ min_r:
}

// --- __clamp ---
od_ clamp(&i&cl_x& ! &i&cl_lo& ! &i&cl_hi&){
    int_ &i&cl_r&:
    cl_r = cl_x:
    if(cl_x < cl_lo){
        cl_r = cl_lo:
    }
    oth if(cl_x > cl_hi){
        cl_r = cl_hi:
    }
    oth{
    }
    deven_ cl_r:
}

// --- __pow : base^exp con exp >= 0. pow(x,0)=1 ---
od_ pow(&i&pw_base& ! &i&pw_exp&){
    int_ &i&pw_r&:
    int_ &i&pw_i&:
    pw_r = 1:
    pw_i = 0:
    during(pw_i < pw_exp ! pw_i++){
        pw_r = pw_r * pw_base:
    }
    deven_ pw_r:
}

// --- __sqrt_int : usa l'operatore ~~ nativo ---
// Copia in locale per non sovrascrivere il parametro (pass-by-ref).
od_ sqrt_int(&i&sq_x&){
    int_ &i&sq_r&:
    sq_r = sq_x:
    sq_r~~:
    deven_ sq_r:
}

// --- __factorial : n! con n >= 0. factorial(0)=1, factorial(1)=1 ---
od_ factorial(&i&fac_n&){
    int_ &i&fac_r&:
    int_ &i&fac_i&:
    fac_r = 1:
    fac_i = 2:
    during(fac_i < fac_n ! fac_i++){
        fac_r = fac_r * fac_i:
    }
    // moltiplica per n solo se n >= 2 (evita n=0 che darebbe 0)
    if(fac_n >> 2){
        fac_r = fac_r * fac_n:
    }
    oth{
    }
    deven_ fac_r:
}

// --- __divmod_rem : a % b  (resto intero) ---
od_ divmod_rem(&i&dr_a& ! &i&dr_b&){
    int_ &i&dr_q&:
    int_ &i&dr_r&:
    dr_q = dr_a / dr_b:
    dr_r = dr_q * dr_b:
    dr_r = dr_a - dr_r:
    deven_ dr_r:
}

// --- __divmod_quot : a / b  (quoziente intero) ---
od_ divmod_quot(&i&dq_a& ! &i&dq_b&){
    int_ &i&dq_r&:
    dq_r = dq_a / dq_b:
    deven_ dq_r:
}

// --- __gcd : massimo comun divisore con algoritmo di Euclide ---
// Usa variabili locali per non distruggere i parametri (pass-by-ref).
od_ gcd(&i&gcd_a& ! &i&gcd_b&){
    int_ &i&ga&:
    int_ &i&gb&:
    int_ &i&gt&:
    int_ &i&gm&:
    ga = gcd_a:
    gb = gcd_b:
    during(gb ^= 0){
        gt = gb:
        gm = __divmod_rem(ga ! gb):
        ga = gt:
        gb = gm:
    }
    deven_ ga:
}

// --- __lcm : minimo comune multiplo ---
od_ lcm(&i&lcm_a& ! &i&lcm_b&){
    int_ &i&lcm_g&:
    int_ &i&lcm_r&:
    lcm_g = __gcd(lcm_a ! lcm_b):
    lcm_r = lcm_a / lcm_g:
    lcm_r = lcm_r * lcm_b:
    deven_ lcm_r:
}

// --- __is_even : 1 se n e' pari, 0 altrimenti ---
od_ is_even(&i&ie_n&){
    int_ &i&ie_r&:
    int_ &i&ie_mod&:
    ie_mod = __divmod_rem(ie_n ! 2):
    ie_r = 0:
    if(ie_mod == 0){
        ie_r = 1:
    }
    oth{
    }
    deven_ ie_r:
}

// --- __is_odd : 1 se n e' dispari, 0 altrimenti ---
od_ is_odd(&i&io_n&){
    int_ &i&io_r&:
    io_r = __is_even(io_n):
    if(io_r == 1){
        io_r = 0:
    }
    oth{
        io_r = 1:
    }
    deven_ io_r:
}

// --- __sign : 1 se n>0, -1 se n<0, 0 se n==0 ---
od_ sign(&i&sg_n&){
    int_ &i&sg_r&:
    sg_r = 0:
    if(sg_n > 0){
        sg_r = 1:
    }
    oth if(sg_n < 0){
        sg_r = 0:
        sg_r--1:
    }
    oth{
    }
    deven_ sg_r:
}


// ============================================================
//  SEZIONE 3 — UTILITY  (array e matrici int)
//
//  __array_fill(arr, val, n)       → riempie n celle con val
//  __array_sum(arr, n)             → somma dei primi n elementi
//  __array_min(arr, n)             → minimo nei primi n
//  __array_max(arr, n)             → massimo nei primi n
//  __array_reverse(arr, n)         → inverte i primi n elementi
//  __array_contains(arr, val, n)   → 1 se val e' presente
//  __array_index_of(arr, val, n)   → primo indice di val, -99 se assente
//  __array_copy(src, dst, n)       → copia n elementi da src a dst
//  __bubble_sort(arr, n)           → ordina crescente i primi n elementi
//  __matrix_zero(mat, rows, cols)  → azzera tutta la matrice
//  __matrix_fill(mat, val, r, c)   → riempie la matrice con val
//  __matrix_sum(mat, rows, cols)   → somma di tutti gli elementi
//  __matrix_trace(mat, n)          → traccia di una matrice quadrata n x n
// ============================================================

// --- __array_fill ---
od_ array_fill(&a&af_arr& ! &i&af_val& ! &i&af_n&){
    int_ &i&af_i&:
    af_i = 0:
    during(af_i < af_n ! af_i++){
        [af_i]af_arr = af_val:
    }
    deven_:
}

// --- __array_sum ---
od_ array_sum(&a&as_arr& ! &i&as_n&){
    int_ &i&as_i&:
    int_ &i&as_s&:
    as_i = 0:
    as_s = 0:
    during(as_i < as_n ! as_i++){
        as_s = as_s + [as_i]as_arr:
    }
    deven_ as_s:
}

// --- __array_min ---
od_ array_min(&a&amin_arr& ! &i&amin_n&){
    int_ &i&amin_i&:
    int_ &i&amin_m&:
    amin_m = [0]amin_arr:
    amin_i = 1:
    during(amin_i < amin_n ! amin_i++){
        if([amin_i]amin_arr < amin_m){
            amin_m = [amin_i]amin_arr:
        }
        oth{
        }
    }
    deven_ amin_m:
}

// --- __array_max ---
od_ array_max(&a&amax_arr& ! &i&amax_n&){
    int_ &i&amax_i&:
    int_ &i&amax_m&:
    amax_m = [0]amax_arr:
    amax_i = 1:
    during(amax_i < amax_n ! amax_i++){
        if([amax_i]amax_arr > amax_m){
            amax_m = [amax_i]amax_arr:
        }
        oth{
        }
    }
    deven_ amax_m:
}

// --- __array_reverse : inverte i primi arv_n elementi int ---
// Usa condition-style: count-style valuterebbe N una sola volta.
od_ array_reverse(&a&arv_arr& ! &i&arv_n&){
    int_ &i&arv_l&:
    int_ &i&arv_r&:
    int_ &i&arv_tmp&:
    arv_l = 0:
    arv_r = arv_n:
    arv_r--:
    during(arv_l < arv_r ! arv_l++){
        arv_tmp     = [arv_l]arv_arr:
        [arv_l]arv_arr = [arv_r]arv_arr:
        [arv_r]arv_arr = arv_tmp:
        arv_r--:
    }
    deven_:
}

// --- __array_contains : 1 se ac_val e' presente, 0 altrimenti ---
od_ array_contains(&a&ac_arr& ! &i&ac_val& ! &i&ac_n&){
    int_ &i&ac_i&:
    int_ &i&ac_r&:
    ac_i = 0:
    ac_r = 0:
    during(ac_i < ac_n ! ac_i++){
        if([ac_i]ac_arr == ac_val){
            ac_r = 1:
        }
        oth{
        }
    }
    deven_ ac_r:
}

// --- __array_index_of : primo indice di aio_val, -99 se assente ---
od_ array_index_of(&a&aio_arr& ! &i&aio_val& ! &i&aio_n&){
    int_ &i&aio_i&:
    int_ &i&aio_r&:
    int_ &i&aio_found&:
    aio_i     = 0:
    aio_r     = 0:
    aio_r--99:
    aio_found = 0:
    during(aio_i < aio_n ! aio_i++){
        if([aio_i]aio_arr == aio_val){
            if(aio_found == 0){
                aio_r     = aio_i:
                aio_found = 1:
            }
            oth{
            }
        }
        oth{
        }
    }
    deven_ aio_r:
}

// --- __array_copy : copia acp_n elementi int da acp_src a acp_dst ---
od_ array_copy(&a&acp_src& ! &a&acp_dst& ! &i&acp_n&){
    int_ &i&acp_i&:
    acp_i = 0:
    during(acp_i < acp_n ! acp_i++){
        [acp_i]acp_dst = [acp_i]acp_src:
    }
    deven_:
}

// --- __bubble_sort : ordina crescente i primi bs_n elementi int ---
// bs_jn dichiarata fuori dal loop per non consumare slot ad ogni iter.
od_ bubble_sort(&a&bs_arr& ! &i&bs_n&){
    int_ &i&bs_i&:
    int_ &i&bs_j&:
    int_ &i&bs_jn&:
    int_ &i&bs_tmp&:
    int_ &i&bs_lim&:
    bs_i = 0:
    during(bs_i < bs_n ! bs_i++){
        bs_j   = 0:
        bs_lim = bs_n:
        bs_lim--bs_i:
        bs_lim--:
        during(bs_j < bs_lim ! bs_j++){
            bs_jn = bs_j:
            bs_jn++:
            if([bs_j]bs_arr > [bs_jn]bs_arr){
                bs_tmp         = [bs_j]bs_arr:
                [bs_j]bs_arr   = [bs_jn]bs_arr:
                [bs_jn]bs_arr  = bs_tmp:
            }
            oth{
            }
        }
    }
    deven_:
}

// --- __matrix_zero : azzera tutta la matrice mz_mat ---
od_ matrix_zero(&m&mz_mat& ! &i&mz_rows& ! &i&mz_cols&){
    int_ &i&mz_i&:
    int_ &i&mz_j&:
    mz_i = 0:
    during(mz_i < mz_rows ! mz_i++){
        mz_j = 0:
        during(mz_j < mz_cols ! mz_j++){
            [mz_i][mz_j]mz_mat = 0:
        }
    }
    deven_:
}

// --- __matrix_fill : riempie tutta la matrice mf_mat con mf_val ---
od_ matrix_fill(&m&mf_mat& ! &i&mf_val& ! &i&mf_rows& ! &i&mf_cols&){
    int_ &i&mf_i&:
    int_ &i&mf_j&:
    mf_i = 0:
    during(mf_i < mf_rows ! mf_i++){
        mf_j = 0:
        during(mf_j < mf_cols ! mf_j++){
            [mf_i][mf_j]mf_mat = mf_val:
        }
    }
    deven_:
}

// --- __matrix_sum : somma di tutti gli elementi di ms_mat ---
od_ matrix_sum(&m&ms_mat& ! &i&ms_rows& ! &i&ms_cols&){
    int_ &i&ms_i&:
    int_ &i&ms_j&:
    int_ &i&ms_s&:
    ms_i = 0:
    ms_s = 0:
    during(ms_i < ms_rows ! ms_i++){
        ms_j = 0:
        during(ms_j < ms_cols ! ms_j++){
            ms_s = ms_s + [ms_i][ms_j]ms_mat:
        }
    }
    deven_ ms_s:
}

// --- __matrix_trace : somma della diagonale principale di una matrice n x n ---
od_ matrix_trace(&m&mt_mat& ! &i&mt_n&){
    int_ &i&mt_i&:
    int_ &i&mt_s&:
    mt_i = 0:
    mt_s = 0:
    during(mt_i < mt_n ! mt_i++){
        mt_s = mt_s + [mt_i][mt_i]mt_mat:
    }
    deven_ mt_s:
}
