// ============================================================:
// demo_libstd.Zim — demo di libstd.Zlib:
// Esegui con::
//   ./Zinterpreter -df demo_libstd.Zim -libstd.Zlib:
// ============================================================:

#{
    debug_ -df:
    exec_:
}

__start(){

    // Buffer globale per stringhe (richiesto dalle funzioni str*):
    char_ &s[128]& _sbuf_ &:

    // Buffer globale per array interi (richiesto dalle funzioni arr*):
    int_ &i[64]& _ibuf_ &:

    // Variabili di lavoro:
    int_ &i&res&:
    int_ &i&i&:


    // --------------------------------------------------------:
    // SEZIONE MATH:
    // --------------------------------------------------------:

    __banner_(40):    // stampa intestazione — _sbuf_ e' vuoto, ok:

    // abs_:
    res = __abs_(-17):
    print_ &s&"abs(-17)   = "&:
    println_ res:

    // max_ / min_:
    res = __max_(12!7):
    print_ &s&"max(12,7)  = "&:
    println_ res:

    res = __min_(12!7):
    print_ &s&"min(12,7)  = "&:
    println_ res:

    // clamp_:
    res = __clamp_(150!0!100):
    print_ &s&"clamp(150,0,100) = "&:
    println_ res:

    // sq_ / sqrt_:
    res = __sq_(9):
    print_ &s&"sq(9)      = "&:
    println_ res:

    res = __sqrt_(81):
    print_ &s&"sqrt(81)   = "&:
    println_ res:

    // pow2_:
    res = __pow2_(8):
    print_ &s&"2^8        = "&:
    println_ res:

    // iseven_ / isodd_:
    res = __iseven_(6):
    print_ &s&"iseven(6)  = "&:
    println_ res:

    res = __isodd_(7):
    print_ &s&"isodd(7)   = "&:
    println_ res:

    // digits_:
    res = __digits_(12345):
    print_ &s&"digits(12345) = "&:
    println_ res:

    // sum_upto_:
    res = __sum_upto_(10):
    print_ &s&"sum 1..10  = "&:
    println_ res:

    __nl_(1):


    // --------------------------------------------------------:
    // SEZIONE CHAR / STRING:
    // --------------------------------------------------------:

    __printeq_(40):

    // Carica manualmente "Ciao" in _sbuf_  (C=67 i=105 a=97 o=111):
    [0]_sbuf_ = 67:
    [1]_sbuf_ = 105:
    [2]_sbuf_ = 97:
    [3]_sbuf_ = 111:
    [4]_sbuf_ = 0:

    res = __strlen_():
    print_ &s&"strlen(_sbuf_) = "&:
    println_ res:

    // toupper_ su 'a' (97):
    res = __toupper_(97):
    print_ &s&"toupper('a') = "&:
    println_ res:

    // tolower_ su 'Z' (90):
    res = __tolower_(90):
    print_ &s&"tolower('Z') = "&:
    println_ res:

    // isdigitc_ su '5' (53):
    res = __isdigitc_(53):
    print_ &s&"isdigitc('5') = "&:
    println_ res:

    // isalphac_ su 'B' (66):
    res = __isalphac_(66):
    print_ &s&"isalphac('B') = "&:
    println_ res:

    // strfill_ con '#' (35), 6 caratteri:
    __strfill_(6!35):
    print_ &s&"strfill(6,'#') -> _sbuf_[0]= "&:
    println_ [0]_sbuf_:

    __nl_(1):


    // --------------------------------------------------------:
    // SEZIONE TERMINAL:
    // --------------------------------------------------------:

    __printeq_(40):
    println_ &s&"  DISEGNO ASCII"&:
    __printeq_(40):
    __nl_(1):

    // Linea di trattini:
    __printline_(30):

    // Box 20x3:
    __box_(20!3):

    __nl_(1):

    // Ruler (righello numerico):
    __ruler_(20):

    // Indentazione:
    __indent_(4):
    println_ &s&"<- 4 spazi di indent"&:

    __nl_(1):


    // --------------------------------------------------------:
    // SEZIONE ARRAY INTERI:
    // --------------------------------------------------------:

    __printeq_(40):

    // Riempie _ibuf_ con valori 10,20,30,40,50:
    [0]_ibuf_ = 10:
    [1]_ibuf_ = 20:
    [2]_ibuf_ = 30:
    [3]_ibuf_ = 40:
    [4]_ibuf_ = 50:

    print_ &s&"Array: "&:
    __arrprint_(5):

    res = __arrsum_(5):
    print_ &s&"arrsum(5)  = "&:
    println_ res:

    res = __arrmax_(5):
    print_ &s&"arrmax(5)  = "&:
    println_ res:

    res = __arrmin_(5):
    print_ &s&"arrmin(5)  = "&:
    println_ res:

    res = __arrcount_(5!30):
    print_ &s&"arrcount(5,30) = "&:
    println_ res:

    // Reverse:
    __arrreverse_(5):
    print_ &s&"reverse -> "&:
    __arrprint_(5):

    __nl_(1):


    // --------------------------------------------------------:
    // SEZIONE LOGICA:
    // --------------------------------------------------------:

    __printeq_(40):

    res = __not_(0):
    print_ &s&"not(0)   = "&:
    println_ res:

    res = __and_(1!1):
    print_ &s&"and(1,1) = "&:
    println_ res:

    res = __or_(0!1):
    print_ &s&"or(0,1)  = "&:
    println_ res:

    res = __xor_(1!1):
    print_ &s&"xor(1,1) = "&:
    println_ res:

    res = __xor_(1!0):
    print_ &s&"xor(1,0) = "&:
    println_ res:

    __nl_(1):
    __printeq_(40):
    println_ &s&"  FINE DEMO"&:
    __printeq_(40):
}
