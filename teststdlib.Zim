#{
    debug_ -df:
    exec_:
}

__start(){
    
    // ============================================================:
    // INIZIALIZZAZIONE AMBIENTE E CONTATORE:
    // ============================================================:
    int_ &i&err_count&:
    err_count = 0:

    println_ &s&"=== INIZIO TEST AUTOMATICO STDLIB ==="&:
    println_:

    // Variabili d'appoggio generali:
    char_ &s[5]&stringat&:
    char_ &s[5]&strcopy&:
    char_ &c&res&:
    int_ &i&ris&:
    int_ &i&negval&:

    // ============================================================:
    // SEZIONE 1: TEST STRING:
    // ============================================================:
    println_ &s&"--- TEST STRING ---"&:

    [4]stringat = 'j':
    [3]stringat = 'r':
    [2]stringat = '\0':
    [1]stringat = 's':
    [0]stringat = 'f':

    // Test string_at:
    res = __string_at(stringat ! 4):
    if(res == 'j'){
        println_ &s&"[OK] string_at"&:
    }
    oth{
        println_ &s&"[FAIL] string_at"&:
        err_count++:
    }

    // Test len:
    ris = __len(stringat ! 5):
    if(ris == 4){
        println_ &s&"[OK] len"&:
    }
    oth{
        println_ &s&"[FAIL] len"&:
        err_count++:
    }

    // Test copy:
    __copy(stringat ! strcopy ! 5):
    res = __string_at(strcopy ! 4):
    if(res == 'j'){
        println_ &s&"[OK] copy"&:
    }
    oth{
        println_ &s&"[FAIL] copy"&:
        err_count++:
    }

    // Test cmp:
    ris = __cmp(stringat ! strcopy ! 5):
    if(ris == 1){
        println_ &s&"[OK] cmp"&:
    }
    oth{
        println_ &s&"[FAIL] cmp"&:
        err_count++:
    }

    // Test string_fill:
    __string_fill(strcopy ! 'A' ! 5):
    res = __string_at(strcopy ! 0):
    if(res == 'A'){
        println_ &s&"[OK] string_fill"&:
    }
    oth{
        println_ &s&"[FAIL] string_fill"&:
        err_count++:
    }

    // Test string_count:
    ris = __string_count(strcopy ! 'A' ! 5):
    if(ris == 5){
        println_ &s&"[OK] string_count"&:
    }
    oth{
        println_ &s&"[FAIL] string_count"&:
        err_count++:
    }

    // Test reverse:
    __reverse(stringat ! 5):
    res = __string_at(stringat ! 0):
    if(res == 'j'){
        println_ &s&"[OK] reverse"&:
    }
    oth{
        println_ &s&"[FAIL] reverse"&:
        err_count++:
    }
    println_:

    // ============================================================:
    // SEZIONE 2: TEST MATH:
    // ============================================================:
    println_ &s&"--- TEST MATH ---"&:
    
    // Genero un valore negativo senza letterali negativi nativi:
    negval = 0:
    negval--5: 

    // Test abs:
    ris = __abs(negval):
    if(ris == 5){
        println_ &s&"[OK] abs"&:
    }
    oth{
        println_ &s&"[FAIL] abs"&:
        err_count++:
    }

    // Test max:
    ris = __max(10 ! 20):
    if(ris == 20){
        println_ &s&"[OK] max"&:
    }
    oth{
        println_ &s&"[FAIL] max"&:
        err_count++:
    }

    // Test min:
    ris = __min(10 ! 20):
    if(ris == 10){
        println_ &s&"[OK] min"&:
    }
    oth{
        println_ &s&"[FAIL] min"&:
        err_count++:
    }

    // Test clamp:
    ris = __clamp(25 ! 0 ! 10):
    if(ris == 10){
        println_ &s&"[OK] clamp"&:
    }
    oth{
        println_ &s&"[FAIL] clamp"&:
        err_count++:
    }

    // Test pow:
    ris = __pow(2 ! 3):
    if(ris == 8){
        println_ &s&"[OK] pow"&:
    }
    oth{
        println_ &s&"[FAIL] pow"&:
        err_count++:
    }

    // Test factorial:
    ris = __factorial(4):
    if(ris == 24){
        println_ &s&"[OK] factorial"&:
    }
    oth{
        println_ &s&"[FAIL] factorial"&:
        err_count++:
    }

    // Test divmod_rem:
    ris = __divmod_rem(10 ! 3):
    if(ris == 1){
        println_ &s&"[OK] divmod_rem"&:
    }
    oth{
        println_ &s&"[FAIL] divmod_rem"&:
        err_count++:
    }

    // Test gcd:
    ris = __gcd(54 ! 24):
    if(ris == 6){
        println_ &s&"[OK] gcd"&:
    }
    oth{
        println_ &s&"[FAIL] gcd"&:
        err_count++:
    }

    // Test lcm:
    ris = __lcm(4 ! 6):
    if(ris == 12){
        println_ &s&"[OK] lcm"&:
    }
    oth{
        println_ &s&"[FAIL] lcm"&:
        err_count++:
    }

    // Test is_even:
    ris = __is_even(4):
    if(ris == 1){
        println_ &s&"[OK] is_even"&:
    }
    oth{
        println_ &s&"[FAIL] is_even"&:
        err_count++:
    }

    // Test sign:
    ris = __sign(negval):
    if(ris == -1){
        println_ &s&"[OK] sign"&:
    }
    oth{
        // Se non compila -1 come letterale gestiamo un controllo alternativo:
        // dato che -1 in zinterpl potrebbe esser un problema logico:
        if(ris < 0){
            println_ &s&"[OK] sign (verificato minore di 0)"&:
        }
        oth{
            println_ &s&"[FAIL] sign"&:
            err_count++:
        }
    }
    println_:

    // ============================================================:
    // SEZIONE 3: TEST UTILITY (ARRAY & MATRICI):
    // ============================================================:
    println_ &s&"--- TEST UTILITY ---"&:
    int_ &i[5]&iarr&:
    int_ &i[3][3]&imat&:

    // Test array_fill:
    __array_fill(iarr ! 7 ! 5):
    if([0]iarr == 7){
        println_ &s&"[OK] array_fill"&:
    }
    oth{
        println_ &s&"[FAIL] array_fill"&:
        err_count++:
    }

    // Prep dati per i prossimi test array:
    [0]iarr = 2:
    [1]iarr = 4:
    [2]iarr = 6:
    [3]iarr = 8:
    [4]iarr = 10:

    // Test array_sum:
    ris = __array_sum(iarr ! 5):
    if(ris == 30){
        println_ &s&"[OK] array_sum"&:
    }
    oth{
        println_ &s&"[FAIL] array_sum"&:
        err_count++:
    }

    // Test array_min:
    ris = __array_min(iarr ! 5):
    if(ris == 2){
        println_ &s&"[OK] array_min"&:
    }
    oth{
        println_ &s&"[FAIL] array_min"&:
        err_count++:
    }

    // Test array_max:
    ris = __array_max(iarr ! 5):
    if(ris == 10){
        println_ &s&"[OK] array_max"&:
    }
    oth{
        println_ &s&"[FAIL] array_max"&:
        err_count++:
    }

    // Test array_contains:
    ris = __array_contains(iarr ! 8 ! 5):
    if(ris == 1){
        println_ &s&"[OK] array_contains"&:
    }
    oth{
        println_ &s&"[FAIL] array_contains"&:
        err_count++:
    }

    // Test array_index_of:
    ris = __array_index_of(iarr ! 8 ! 5):
    if(ris == 3){
        println_ &s&"[OK] array_index_of"&:
    }
    oth{
        println_ &s&"[FAIL] array_index_of"&:
        err_count++:
    }

    // Test array_reverse:
    __array_reverse(iarr ! 5):
    if([0]iarr == 10){
        println_ &s&"[OK] array_reverse"&:
    }
    oth{
        println_ &s&"[FAIL] array_reverse"&:
        err_count++:
    }

    // Test Bubble Sort:
    [0]iarr = 9:
    [1]iarr = 1:
    [2]iarr = 5:
    [3]iarr = 2:
    [4]iarr = 8:
    __bubble_sort(iarr ! 5):
    if([0]iarr == 1){
        if([4]iarr == 9){
            println_ &s&"[OK] bubble_sort"&:
        }
        oth{
            println_ &s&"[FAIL] bubble_sort (max errato)"&:
            err_count++:
        }
    }
    oth{
        println_ &s&"[FAIL] bubble_sort (min errato)"&:
        err_count++:
    }

    // Test matrix_fill e matrix_sum:
    __matrix_fill(imat ! 3 ! 3 ! 3):
    ris = __matrix_sum(imat ! 3 ! 3):
    if(ris == 27){
        println_ &s&"[OK] matrix_sum (e matrix_fill)"&:
    }
    oth{
        println_ &s&"[FAIL] matrix_sum / matrix_fill"&:
        err_count++:
    }

    // Test matrix_zero e matrix_trace:
    __matrix_zero(imat ! 3 ! 3):
    [0][0]imat = 5:
    [1][1]imat = 5:
    [2][2]imat = 5:
    ris = __matrix_trace(imat ! 3):
    if(ris == 15){
        println_ &s&"[OK] matrix_trace (e matrix_zero)"&:
    }
    oth{
        println_ &s&"[FAIL] matrix_trace / matrix_zero"&:
        err_count++:
    }

    println_:
    // ============================================================:
    // RESOCONTO FINALE:
    // ============================================================:
    println_ &s&"====== RISULTATI TEST ======"&:
    
    if(err_count == 0){
        println_ &s&"-> SUCCESSO: Tutti i test sono passati correttamente!"&:
    }
    oth{
        print_ err_count:
        println_ &s&" ERRORI RILEVATI DURANTE I TEST!"&:
    }
    
    println_ &s&"============================"&:
    println_:
}
