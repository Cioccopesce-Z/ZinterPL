od_ test_pass(){
    int var:
    var = 78:
    
    char [5]$harr:
    [4]$harr = 'f':

    int [3][3]mall:
    [0][1]mall = 96:

    __pass_by_ref(var ! $harr ! mall ! mall):

    print var: println &s&" 79 modified because ref"&:
    print [4]$harr: println &s&" 55 if type change works"&:
    print [0][1]mall: println &s&" 44 if if copy works a copy"&:

    deven_:
    
}

od_ pass_by_ref(&i&var& ! &a&$arr& ! &m&matrix& ! cp &m&mal& ){
    var++:
    print [4]$arr: println &s&" f passed by ref old $harr now arr"&:
    [4]$arr = 55:
    print [4]$arr: println &s&" 55 passed by ref old $harr now arr"&:
    print [0][1]matrix: println &s&" 96 as ref"&:
    [0][1]matrix = 44:
    print [0][1]matrix: println &s&" 44 as ref"&:
    
    print [0][1]mal: println &s&" 96 as copy"&:
    [0][1]mal = 66:
    print [0][1]mal: println &s&" 66 as copy"&:
    println:
    
    deven_:
    
}

od_ test_rvc(){
    int n:
    n = 10:
    char c:
    c = 'A':
    int [3]arr:
    [1]arr = 20:
    int [2][2]mat:
    [0][1]mat = 30:

    __ref_vs_copy(n ! n ! c ! c ! arr ! arr ! mat ! mat):
    println:
    println &s&"--- dopo la chiamata, valori ORIGINALI ---"&:
    print n: println &s&" 11 - n modificata (passata per riferimento)"&:
    print c: println &s&" Z - c modificata (passata per riferimento)"&:
    print [1]arr: println &s&" 999 - arr[1] modificato (passato per riferimento)"&:
    print [0][1]mat: println &s&" 777 - mat[0][1] modificato (passato per riferimento)"&:

    deven_:
}

od_ ref_vs_copy(&i&rn& ! cp &i&cn& ! &c&rc& ! cp &c&cc& ! &a&rarr& ! cp &a&carr& ! &m&rmat& ! cp &m&cmat&){

    rn++:
    rc = 'Z':
    [1]rarr = 999:
    [0][1]rmat = 777:

    cn = -1:
    cc = 'Q':
    [1]carr = -999:
    [0][1]cmat = -777:

    println &s&"--- dentro la funzione, copie LOCALI ---"&:
    print cn: println &s&" -1 - copia int modificata (non deve toccare n)"&:
    print cc: println &s&" Q - copia char modificata (non deve toccare c)"&:
    print [1]carr: println &s&" -999 - copia array modificata (non deve toccare arr)"&:
    print [0][1]cmat: println &s&" -777 - copia matrice modificata (non deve toccare mat)"&:

    deven_:
}

od_ test_defaults(){
    println:
    print __with_default(5): println &s&" 15 - a passato esplicito (5), b usa il default (10)"&:
    print __with_default(): println &s&" 22 - a e b usano entrambi il default (12+10)"&:
    deven_:
}

