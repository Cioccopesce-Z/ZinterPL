#{
    debug_ -df:
    exec_:
}

od_ retretfunc(){

    int_ &i&inner&:
    deven_ __differenza():

}

od_ somma(){
    int_ &i&a&:
    int_ &i&b&:
    a = 3:
    b = 5:
    int_ &i&res&:
    res = a + b:
    deven_ res:
}

od_ differenza(){
    int_ &i&a&:
    int_ &i&b&:
    a = 10:
    b = 4:
    int_ &i&res&:
    res = a - b:
    deven_ res:
}

od_ prodotto(){
    int_ &i&a&:
    int_ &i&b&:
    a = 6:
    b = 7&:
    int_ &i&res&:
    res = a * b:
    deven_ res:
}

od_ divisione(){
    int_ &i&a&:
    int_ &i&b&:
    a = 20:
    b = 4:
    int_ &i&res&:
    res = a / b:
    deven_ res:
}

od_ testargs(&i&a&!&i&b&){
    int_&i&risultato&:
    risultato=a+b:
    deven_ risultato:
}

od_ hello(){
    println_ &s&"hello from void function"&:
    deven_:
}

od_ get_char(){
    char_ &c&ch&:
    ch = 'Z':
    deven_ ch:
}

__start(){

    //=== TEST LIB FUNCTION ===:
    println_ &s&"=== TEST LIB FUNCTION ==="&:
    __printciao():
    __printhello():

    int_  &i&v0&:
    int_  &i&v1&:
    int_  &i&v2&:
    int_  &i&row&:
    int_  &i&col&:
    char_ &c&cv0&:
    char_ &c&cv1&:

    int_  &i[5]&iarr&:
    char_ &s[5]&sarr&:

    int_  &i[3][3]&imat&:
    char_ &s[3][3]&smat&:

    println_:
    //=== VOID FUNCTION ===:
    println_ &s&"=== VOID FUNCTION ==="&:
    __hello():

    println_:
    //=== ARGS FUNCTION ===:
    println_ &s&"=== ARGS FUNCTION ==="&:
    print_ __testargs(10!20): println_ &s&" 30 - testargs(10!20)"&:

    println_:
    //=== FUNCTION IN VAR ===:
    println_ &s&"=== FUNCTION IN VAR ==="&:
    v0 = __somma():
    print_ v0: println_ &s&" 8 - somma() in var"&:

    v0 = __differenza():
    print_ v0: println_ &s&" 6 - differenza() in var"&:

    v0 = __prodotto():
    print_ v0: println_ &s&" 42 - prodotto() in var"&:

    v0 = __divisione():
    print_ v0: println_ &s&" 5 - divisione() in var"&:

    cv0 = __get_char():
    print_ cv0: println_ &s&" Z - get_char() in cvar"&:

    println_:
    //=== FUNCTION IN ARR ===:
    println_ &s&"=== FUNCTION IN ARR ==="&:
    [0]iarr = __somma():
    print_ [0]iarr: println_ &s&" 8 - somma() in arr[0]"&:

    [1]iarr = __prodotto():
    print_ [1]iarr: println_ &s&" 42 - prodotto() in arr[1]"&:

    [0]sarr = __get_char():
    print_ [0]sarr: println_ &s&" Z - get_char() in sarr[0]"&:

    println_:
    //=== FUNCTION IN FUNCTION ===:
    println_ &s&"=== FUNCTION IN FUNCTION ==="&:
    print_ __retretfunc():
    println_ &s&" 6 - differenza() in retretfunc()"&:


    println_:
    //=== FUNCTION IN MATR ===:
    println_ &s&"=== FUNCTION IN MATR ==="&:
    [0][0]imat = __somma():
    print_ [0][0]imat: println_ &s&" 8 - somma() in imat[0][0]"&:

    [1][2]imat = __prodotto():
    print_ [1][2]imat: println_ &s&" 42 - prodotto() in imat[1][2]"&:

    [0][0]smat = __get_char():
    print_ [0][0]smat: println_ &s&" Z - get_char() in smat[0][0]"&:

    println_:
    //=== MATH IN VAR ===:
    println_ &s&"=== MATH IN VAR ==="&:

    int_ &i&plusplus&:

    plusplus = 3:
    print_ plusplus: println_ &s&" 3 - plusplus"&:

    plusplus++:
    print_ plusplus: println_ &s&" 4 - plusplus++"&:

    plusplus--:
    print_ plusplus: println_ &s&" 3 - plusplus--"&:

    plusplus++2:
    print_ plusplus: println_ &s&" 5 - plusplus++2"&:

    plusplus--4:
    print_ plusplus: println_ &s&" 1 - plusplus--4"&:

    println_:

    int_ &i[3]&parr&:

    [0]parr = 3:
    print_ [0]parr: println_ &s&" 3 - [0]parr"&:

    [0]parr++:
    print_ [0]parr: println_ &s&" 4 - [0]parr++"&:

    [0]parr--:
    print_ [0]parr: println_ &s&" 3 - [0]parr--"&:

    [0]parr++2:
    print_ [0]parr: println_ &s&" 5 - [0]parr++2"&:

    [0]parr--4:
    print_ [0]parr: println_ &s&" 1 - [0]parr--4"&:

    println_:

    char_ &s[5]&carr&:

    [0]carr = 'F':
    print_ [0]carr: println_ &s&" F - [0]carr"&:

    [0]carr++:
    print_ [1]carr: println_ &s&" F - [1]carr++"&:

    [1]carr++3:
    print_ [4]carr: println_ &s&" F - [4]carr++"&:
    
    println_:

    v0 = 10:
    v1 = 3:

    v2 = v0 + v1:
    print_ v2: println_ &s&" 13 - var+var in var"&:

    v2 = v0 - v1:
    print_ v2: println_ &s&" 7 - var-var in var"&:

    v2 = v0 * v1:
    print_ v2: println_ &s&" 30 - var*var in var"&:

    v2 = v0 / v1:
    print_ v2: println_ &s&" 3 - var/var in var"&:

    println_:
    //=== MATH IN ARR ===:
    println_ &s&"=== MATH IN ARR ==="&:
    v0 = 4:
    v1 = 6:

    [2]iarr = v0 + v1:
    print_ [2]iarr: println_ &s&" 10 - var+var in arr[2]"&:

    [3]iarr = v1 - v0:
    print_ [3]iarr: println_ &s&" 2 - var-var in arr[3]"&:

    [4]iarr = v0 * v1:
    print_ [4]iarr: println_ &s&" 24 - var*var in arr[4]"&:

    [0]iarr = 5 * v1:
    print_ [0]iarr: println_ &s&" 30 - n*var in arr[0]"&:

    println_:
    //=== MATH IN MATR ===:
    println_ &s&"=== MATH IN MATR ==="&:
    v0 = 9:
    v1 = 3:

    [2][0]imat = v0 + v1:
    print_ [2][0]imat: println_ &s&" 12 - var+var in imat[2][0]"&:

    [2][1]imat = v0 - v1:
    print_ [2][1]imat: println_ &s&" 6 - var-var in imat[2][1]"&:

    [2][2]imat = v0 * v1:
    print_ [2][2]imat: println_ &s&" 27 - var*var in imat[2][2]"&:

    row = 1:
    col = 1:
    [row][col]imat = v0 / v1:
    print_ [1][1]imat: println_ &s&" 3 - var/var in imat[row][col]"&:

    println_:
    //=== SWAP VAR ===:
    println_ &s&"=== SWAP VAR ==="&:
    v0 = 11:
    v1 = 22:
    v2 = v0:
    v0 = v1:
    v1 = v2:
    print_ v0: println_ &s&" 22 - v0 dopo swap"&:
    print_ v1: println_ &s&" 11 - v1 dopo swap"&:

    println_:
    //=== SWAP CVAR ===:
    println_ &s&"=== SWAP CVAR ==="&:
    cv0 = 'A':
    cv1 = 'B':
    char_ &c&ctmp&:
    ctmp = cv0:
    cv0 = cv1:
    cv1 = ctmp:
    print_ cv0: println_ &s&" B - cv0 dopo swap"&:
    print_ cv1: println_ &s&" A - cv1 dopo swap"&:

    println_:
    //=== SWAP ARR ELEMENTS ===:
    println_ &s&"=== SWAP ARR ==="&:
    [0]iarr = 100:
    [1]iarr = 200:
    int_ &i&tmp&:
    tmp = [0]iarr:
    [0]iarr = [1]iarr:
    [1]iarr = tmp:
    print_ [0]iarr: println_ &s&" 200 - arr[0] dopo swap"&:
    print_ [1]iarr: println_ &s&" 100 - arr[1] dopo swap"&:

    println_:
    //=== SWAP MATR ELEMENTS ===:
    println_ &s&"=== SWAP MATR ==="&:
    [0][0]imat = 77:
    [1][1]imat = 88:
    tmp = [0][0]imat:
    [0][0]imat = [1][1]imat:
    [1][1]imat = tmp:
    print_ [0][0]imat: println_ &s&" 88 - imat[0][0] dopo swap"&:
    print_ [1][1]imat: println_ &s&" 77 - imat[1][1] dopo swap"&:

    println_:
    //=== COPY ARR -> MATR ===:
    println_ &s&"=== COPY ARR->MATR e MATR->ARR ==="&:
    [0]iarr = 55:
    [0][2]imat = [0]iarr:
    print_ [0][2]imat: println_ &s&" 55 - arr[0] in imat[0][2]"&:

    [0]iarr = [0][2]imat:
    print_ [0]iarr: println_ &s&" 55 - imat[0][2] in arr[0]"&:

    println_:
    //=== COPY SARR -> SMATR ===:
    println_ &s&"=== COPY SARR->SMATR ==="&:
    [0]sarr = 'M':
    [1][1]smat = [0]sarr:
    print_ [1][1]smat: println_ &s&" M - sarr[0] in smat[1][1]"&:

    [0]sarr = [1][1]smat:
    print_ [0]sarr: println_ &s&" M - smat[1][1] in sarr[0]"&:

    println_:
    //====== CONDITION TEST ============:
    println_ &s&"====== CONDITION TEST ============"&:
    int_ &i&testif&:
    testif = 1:
    println_ testif:

    oth if(testif == 9){
        println_ &s&"non la devi vedere questa scritta oth if"&:
    }
    oth{
        println_ &s&"non la devi vedere questa scritta oth"&:
    }

    if(testif){
        println_ &s&"testif è 1":
    }
    oth if(testif == 9){
        println_ &s&"testif è 9"&:
    }
    oth if(testif == 7){
        println_ &s&"testif è 7"&:
    }
    oth{
        println_ &s&"testif non è 1 o 9 o 7"&:
    }


    println_:
    //====== ERROR VAR TEST ============:
    println_ &s&"====== ERROR VAR TEST ============"&:
    
    b = 0: // non dovrebbe essere accessibile:
    print_ b: println_ &s&"non dovrebbe essere accessibile"&:
    
    println_ &s&"start finito"&:
    status_:
    println_:
}