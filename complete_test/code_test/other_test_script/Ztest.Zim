#{
    import_ &f&ciao.Zlib&:

    debug_ -df:

    exec_:
}

od_ hello(){

    println_ &s&"hello world"&:

    return_:
}

od_ somma(){

    int &i&arg1&:
    arg1 = 3:
    int &i&arg2&:
    arg2 = 5:

    println_ &s&"got in somma"&:

    int_ &i&somma&:

    somma = arg1 + arg2:

    return_ somma:
}

__start(){
    int_ &i&int_var0&:
    int_ &i&index&:
    int_ &i&int_var1&:
    int_ &i&row&:
    int_ &i&col&:

    char_ &c&char_var0&:
    char_ &c&char_var1&:

    int_ &i[5]&int_arr_5&:
    int_ &i[6]&int_arr_6&:

    char_ &s[5]&char_arr_5&:
    char_ &s[6]&char_arr_6&:

    int_ &i[3][3]&int_mat&:
    char_ &s[3][3]&char_mat&:

    index = 0:
    row = 0:
    col = 0:

    println_:

    return_:

    //FUNCTION IN VAR:
    int_var0 = __somma():
    print_ int_var0: 
    println_ &s&" 8 FUNCTION IN VAR"&:

    __hello():

    //N IN VAR:
    int_var0 = 7:
    print_ int_var0: println_ &s&" 7 N IN VAR"&:

    //VAR IN VAR:
    int_var1 = int_var0:
    print_ int_var1: println_ &s&" 7 VAR IN VAR"&:

    //N IN ARR:
    [index]int_arr_5 = 9:
    print_ [0]int_arr_5: println_ &s&" 9 N IN ARR WITH INDEX VAR"&:

    //ARR IN VAR:
    int_var1 = [0]int_arr_5:
    print_ int_var1: println_ &s&" 9 ARR IN VAR"&:

    //VAR IN ARR:
    [1]int_arr_5 = int_var0:
    print_ [1]int_arr_5: println_ &s&" 7 VAR IN ARR"&:

    //ARR IN ARR:
    [3]int_arr_5 = [0]int_arr_5:
    print_ [3]int_arr_5: println_ &s&" 9 ARR IN ARR"&:

    println_ &s&" "&:

    //K IN CVAR:
    char_var0 = 'H':
    print_ char_var0: println_ &s&" H - K IN CVAR"&:

    //CVAR IN CVAR:
    char_var1 = char_var0:
    print_ char_var1: println_ &s&" H - CVAR IN CVAR"&:

    //K IN CARR:
    [0]char_arr_5 = 'L':
    print_ [0]char_arr_5: println_ &s&" L - K IN CARR"&:

    //CARR IN CVAR:
    char_var1 = [0]char_arr_5:
    print_ char_var1: println_ &s&" L - CARR IN CVAR"&:

    //CVAR IN CARR:
    [1]char_arr_5 = char_var0:
    print_ [1]char_arr_5: println_ &s&" H - CVAR IN CARR"&:

    //ARR IN ARR:
    [3]char_arr_5 = [0]char_arr_5:
    print_ [3]char_arr_5: println_ &s&" L - ARR IN ARR"&:

    println_ &s&" "&:

    //=== MATRIX TESTS ===

    //N IN MATR literal index:
    [0][0]int_mat = 42:
    print_ [0][0]int_mat: println_ &s&" 42 - N IN MATR [0][0]"&:

    //N IN MATR with var index row:
    row = 1:
    col = 2:
    [row][col]int_mat = 99:
    print_ [1][2]int_mat: println_ &s&" 99 - N IN MATR [row][col]"&:

    //VAR IN MATR literal index:
    int_var0 = 55:
    [2][0]int_mat = int_var0:
    print_ [2][0]int_mat: println_ &s&" 55 - VAR IN MATR [2][0]"&:

    //VAR IN MATR with var index:
    row = 2:
    col = 1:
    [row][col]int_mat = int_var0:
    print_ [2][1]int_mat: println_ &s&" 55 - VAR IN MATR [row][col]"&:

    //MATR IN VAR literal index:
    int_var1 = [0][0]int_mat:
    print_ &i&int_var1&: println_ &s&" 42 - MATR IN VAR [0][0]"&:

    //MATR IN VAR with var index:
    row = 1:
    col = 2:
    int_var1 = [row][col]int_mat:
    print_ &i&int_var1&: println_ &s&" 99 - MATR IN VAR [row][col]"&:

    //MATR IN ARR:
    [0]int_arr_5 = [0][0]int_mat:
    print_ &i[0]&int_arr_5&: println_ &s&" 42 - MATR IN ARR"&:

    //ARR IN MATR:
    [1]int_arr_5 = 77:
    [0][1]int_mat = [1]int_arr_5:
    print_ &i[0][1]&int_mat&: println_ &s&" 77 - ARR IN MATR"&:

    //MATR IN MATR:
    [1][0]int_mat = [0][0]int_mat:
    print_ &i[1][0]&int_mat&: println_ &s&" 42 - MATR IN MATR"&:

    //MATR IN MATR with var index:
    row = 1:
    col = 0:
    [row][col]int_mat = [0][1]int_mat:
    print_ &i[1][0]&int_mat&: println_ &s&" 77 - MATR IN MATR [row][col]"&:

    println_ &s&" "&:

    //=== CHAR MATRIX TESTS ===

    //K IN CHAR MATR:
    [0][0]char_mat = 'A':
    print_ &s[0][0]&char_mat&: println_ &s&" A - K IN CHAR MATR [0][0]"&:

    //K IN CHAR MATR with var index:
    row = 1:
    col = 1:
    [row][col]char_mat = 'Z':
    print_ &s[1][1]&char_mat&: println_ &s&" Z - K IN CHAR MATR [row][col]"&:

    //CVAR IN CHAR MATR:
    char_var0 = 'X':
    [2][2]char_mat = char_var0:
    print_ &s[2][2]&char_mat&: println_ &s&" X - CVAR IN CHAR MATR [2][2]"&:

    //CHAR MATR IN CVAR:
    char_var1 = [0][0]char_mat:
    print_ &c&char_var1&: println_ &s&" A - CHAR MATR IN CVAR"&:

    //CHAR MATR IN CVAR with var index:
    row = 1:
    col = 1:
    char_var1 = [row][col]char_mat:
    print_ &c&char_var1&: println_ &s&" Z - CHAR MATR IN CVAR [row][col]"&:

    //CHAR MATR IN CARR:
    [0]char_arr_5 = [0][0]char_mat:
    print_ &s[0]&char_arr_5&: println_ &s&" A - CHAR MATR IN CARR"&:

    //CARR IN CHAR MATR:
    [1]char_arr_5 = 'W':
    [2][0]char_mat = [1]char_arr_5:
    print_ &s[2][0]&char_mat&: println_ &s&" W - CARR IN CHAR MATR"&:

    //CHAR MATR IN CHAR MATR:
    [1][2]char_mat = [0][0]char_mat:
    print_ &s[1][2]&char_mat&: println_ &s&" A - CHAR MATR IN CHAR MATR"&:

    println_ &s&" "&:

}