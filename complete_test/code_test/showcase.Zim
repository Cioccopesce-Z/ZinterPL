#{
    debug_ -df:
    exec_:
}


od_ sep(){
    println &s&"+====================================+"&:
    deven_:
}

od_ blank(){
    println:
    deven_:
}

od_ spaces(&i&n&){
    int j:
    j = 0:
    during(j < n ! j++){
        print &s&" "&:
    }
    deven_:
}

od_ stars(&i&n&){
    int j:
    j = 0:
    during(j < n ! j++){
        print &s&"*"&:
    }
    deven_:
}


od_ sq(&i&n&){
    int tmp:
    tmp = n:
    tmp**:
    deven_ tmp:
}

od_ succ(&i&n&){
    deven_ n++:
}

od_ triangle(&i&n&){
    int tmp:
    int res:
    tmp = n + 1:
    res = n * tmp:
    res = res / 2:
    deven_ res:
}



od_ double_val(&i&v&){
    v = v * 2:
    deven_:
}



od_ show_fib(){
    int [13]f:
    int i:
    int a:
    int b:
    int va:
    int vb:

    [0]f = 0:
    [1]f = 1:
    i = 2:
    during(i < 13 ! i++){
        a = i - 1:
        b = i - 2:
        va = [a]f:
        vb = [b]f:
        [i]f = va + vb:
    }

    println &s&"|  [ FIBONACCI - 13 terms ]          |"&:
    __sep():
    print &s&"   "&:
    i = 0:
    during(i < 13 ! i++){
        print [i]f:
        print &s&" "&:
    }
    println:
    deven_:
}


od_ show_powers(){
    int pow:
    int i:
    pow = 1:
    i = 0:
    println &s&"|  [ POWERS OF 2 - first 10 ]        |"&:
    __sep():
    print &s&"   "&:
    during(i < 10 ! i++){
        pow = pow * 2:
        print pow:
        print &s&" "&:
    }
    println:
    deven_:
}


od_ show_pyramid(){
    int rows:
    int i:
    int sp:
    int st:
    rows = 7:
    i = 1:
    println &s&"|  [ STAR PYRAMID ]                  |"&:
    __sep():
    during(i < 8 ! i++){
        print &s&"   "&:
        sp = rows - i:
        st = i * 2:
        st = st -1:
        __spaces(sp):
        __stars(st):
        println:
    }
    deven_:
}


od_ show_byref(){
    int x:
    x = 3:
    println &s&"|  [ PASS-BY-REFERENCE ]             |"&:
    __sep():
    print &s&"   x = "&:
    println x:
    __double_val(x):
    print &s&"   double_val(x)  ->  x = "&:
    println x:
    __double_val(x):
    print &s&"   double_val(x)  ->  x = "&:
    println x:
    __double_val(x):
    print &s&"   double_val(x)  ->  x = "&:
    println x:
    deven_:
}



od_ show_math(){
    int i:

    println &s&"|  [ SQUARES  via  deven n** ]      |"&:
    __sep():
    print &s&"   "&:
    i = 1:
    during(i < 9 ! i++){
        print sq(i):
        print &s&" "&:
    }
    println:

    __blank():

    println &s&"|  [ TRIANGLE NUMBERS ]              |"&:
    __sep():
    print &s&"   "&:
    i = 1:
    during(i < 9 ! i++){
        print __triangle(i):
        print &s&" "&:
    }
    println:
    deven_:
}



od_ countdown(){
    int n:
    n = 10:
    println &s&"|  [ COUNTDOWN ]                     |"&:
    __sep():
    print &s&"   "&:
    during(n > 0 ! n--){
        print n:
        print &s&" "&:
    }
    print &s&"LAUNCH!"&:
    println:
    deven_:
}

od_ defaultest(&i&time& ! &i&var0& var5){
    print &s&"   "&:
    var0 = var0 * time:
    print var0:
    deven_:
}



__start(){
    int var5:
    var5 = 5:

    __sep():
    println &s&"|         Z i n t e r P L           |"&:
    println &s&"|           S H O W C A S E         |"&:
    __sep():
    __blank():

    __show_fib():
    __blank():

    __show_powers():
    __blank():

    __show_pyramid():
    __blank():

    __show_byref():
    __blank():

    __show_math():
    __blank():

    lancio -> countdown:
    println &s&"|  [ FUNCTION RENAME lancio ]        |"&:
    __sep():
    __blank():
    __lancio():
    __blank():

    println &s&"|  [ DEFAULT VALUE ]                |"&:
    __sep():
    __defaultest(3): println &s&" 15 the default value is five"&:
    __defaultest(2!10): println &s&" 20 the default value is changed to ten"&:
    __blank():

    __sep():
    println &s&"|           -- FINE --               |"&:
    __sep():
}